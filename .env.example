# Etsy Open API v3 credentials
# Create an app at https://www.etsy.com/developers/your-apps
ETSY_API_KEY=your_etsy_keystring_here

# Required only for authenticated endpoints (shop management, receipts, creating
# listings, etc). Obtain via the OAuth 2.0 PKCE flow described in the README.
ETSY_ACCESS_TOKEN=
ETSY_REFRESH_TOKEN=

# Optional: base URL override, mainly useful for testing against a mock server
ETSY_API_BASE_URL=https://openapi.etsy.com/v3
